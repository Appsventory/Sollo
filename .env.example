# Copy to .env (or run `php fany make:env`). Never commit .env.
#
# DEVELOPMENT defaults. On a live server set APP_ENV=production and APP_DEBUG=false,
# otherwise error pages show source code and stack traces.

APP_NAME="Sollo"
APP_ENV=local
APP_DEBUG=true
ERROR_DISPLAY=inline
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database (sqlite | mysql | pgsql)
DB_CONNECTION=sqlite
DB_DATABASE=database/sollo.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

# Session lifetime in minutes
SESSION_LIFETIME=120

# API CORS: * or a comma separated list of origins (https://app.example.com,https://admin.example.com)
API_ALLOWED_ORIGINS=*

# Trust X-Forwarded-For / X-Forwarded-Proto only from these proxies (comma separated IPs, or *).
# Leave empty when the app is not behind a reverse proxy.
TRUSTED_PROXIES=
